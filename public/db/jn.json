[{"book_abbrev":"jn","chapter":1,"verse":1,"text_pt":"E VEIO a palavra do SENHOR a Jonas, filho de Amitai, dizendo:","words":[{"hebrew":"וַיְהִי","transliteration":"VAYËHY","portuguese":"E VEIO {lit.: e foi}","number":"1.1"},{"hebrew":"דְּבַר- יְהוָה","transliteration":"DËVAR-YHVH","portuguese":"(a) palavra do SENHOR","number":"1.1"},{"hebrew":"אֶל- יוֹנָה","transliteration":"EL-YONÅH","portuguese":"a Jonas,","number":"1.1"},{"hebrew":"בֶן- אֲמִתַּי","transliteration":"VEN-AMITAY","portuguese":"filho de Amitai,","number":"1.1"},{"hebrew":"לֵאמֹר:","transliteration":"LEMOR:","portuguese":"dizendo: {lit.: dizer}","number":"1.1"}]},{"book_abbrev":"jn","chapter":1,"verse":2,"text_pt":"Levanta-te, vai à grande cidade de Nínive, e clama contra ela, porque a sua malícia subiu até mim.","words":[{"hebrew":"קוּם","transliteration":"QUM","portuguese":"","number":"1.2"},{"hebrew":"לֵךְ","transliteration":"LEKH","portuguese":"","number":"1.2"},{"hebrew":"אֶל- נִינְוֵה","transliteration":"EL-NYNËVEH","portuguese":"","number":"1.2"},{"hebrew":"הָעִיר","transliteration":"HÅYR","portuguese":"","number":"1.2"},{"hebrew":"הַגְּדוֹלָה","transliteration":"HAGËDOLÅH","portuguese":"","number":"1.2"},{"hebrew":"וּקְרָא","transliteration":"UQËRÅ","portuguese":"","number":"1.2"},{"hebrew":"עָלֶיהָ","transliteration":"ÅLEYHÅ","portuguese":"","number":"1.2"},{"hebrew":"כִּי- עָלְתָה","transliteration":"KY-ÅLËTÅH","portuguese":"","number":"1.2"},{"hebrew":"רָעָתָם","transliteration":"RÅÅTÅM","portuguese":"","number":"1.2"},{"hebrew":"לְפָנָי:","transliteration":"LËFÅNÅY:","portuguese":"","number":"1.2"}]},{"book_abbrev":"jn","chapter":1,"verse":3,"text_pt":"E Jonas se levantou para fugir de diante da face do SENHOR para Tarsis; e, descendo a Jope, achou que um navio ia para Tarsis; pagou pois, a sua passagem, e desceu para dentro dele, para ir com eles para Tarsis, de diante da face do SENHOR.","words":[{"hebrew":"וַיָּקָם","transliteration":"VAYÅQÅM","portuguese":"","number":"1.3"},{"hebrew":