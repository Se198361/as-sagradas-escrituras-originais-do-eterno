-GËDOLÅH","portuguese":"","number":"1.4"},{"hebrew":"אֶל- הַיָּם","transliteration":"EL-HAYÅM","portuguese":"","number":"1.4"},{"hebrew":"וַיְהִי","transliteration":"VAYËHY","portuguese":"","number":"1.4"},{"hebrew":"סַעַר- גָּדוֹל","transliteration":"SAAR-GÅDOL","portuguese":"","number":"1.4"},{"hebrew":"בַּיָּם","transliteration":"BAYÅM","portuguese":"","number":"1.4"},{"hebrew":"וְהָאֳנִיָּה","transliteration":"VËHÅONYÅH","portuguese":"","number":"1.4"},{"hebrew":"חִשְּׁבָה","transliteration":"CHISHËVÅH","portuguese":"","number":"1.4"},{"hebrew":"לְהִשָּׁבֵר:","transliteration":"LËHISHÅVER:","portuguese":"","number":"1.4"}]},{"book_abbrev":"jn","chapter":1,"verse":5,"text_pt":"Então temeram os marinheiros, e clamava cada um ao seu deus, e lançavam no mar as fazendas, que estavam no navio, para o aliviarem do seu peso; Jonas porém desceu aos lugares do porão e se deitou, e dormia um profundo sono.","words":[{"hebrew":"וַיִּירְאוּ","transliteration":"VAYYRËU","portuguese":"","number":"1.5"},{"hebrew":"הַמַּלָּחִים","transliteration":"HAMALÅCHYM","portuguese":"","number":"1.5"},{"hebrew":"וַיִּזְעֲקוּ","transliteration":"VAYZËAQU","portuguese":"","number":"1.5"},{"hebrew":"אִישׁ","transliteration":"YSH","portuguese":"","number":"1.5"},{"hebrew":"אֶל- אֱלֹהָיו","transliteration":"EL-ELOHÅYV","portuguese":"","number":"1.5"},{"hebrew":"וַיָּטִלוּ","transliteration":"VAYÅTILU","portuguese":"","number":"1.5"},{"hebrew":"אֶת- הַכֵּלִים","transliteration":"ET-HAKELYM","portuguese":"","number":"1.5"},{"hebrew":"אֲשֶׁר","transliteration":"ASHER","portuguese":"","number":"1.5"},{"hebrew":"בָּאֳנִיָּה","transliteration":"BÅONYÅH","portuguese":"","number":"1.5"},{"hebrew":"אֶל- הַיָּם","transliteration":"EL-HAYÅM","portuguese":"","number":"1.5"},{"hebrew":"לְהָקֵל","transliteration":"LËHÅQEL","portuguese":"","number":"1.5"},{"hebrew":"מֵעֲלֵיהֶם","transliteration":"MEALEYHEM","portuguese":"","number":"1.5"},{"hebrew":"וְיוֹנָה","transliteration":"VËYONÅH","portuguese":"","numbe