ida.","number":"3.4"}]},{"book_abbrev":"jn","chapter":3,"verse":5,"text_pt":"E os homens de Nínive creram em Deus; e proclamaram um jejum, e vestiram-se de saco, desde o maior até ao menor.","words":[{"hebrew":"וַיַּאֲמִינוּ","transliteration":"VAYAAMYNU","portuguese":"E creram","number":"3.5"},{"hebrew":"אַנְשֵׁי","transliteration":"ANËSHEY","portuguese":"(os) homens de","number":"3.5"},{"hebrew":"נִינְוֵה","transliteration":"NYNËVEH","portuguese":"Nínive","number":"3.5"},{"hebrew":"בֵּאלֹהִים","transliteration":"BELOHYM","portuguese":"em Deus;","number":"3.5"},{"hebrew":"וַיִּקְרְאוּ- צוֹם","transliteration":"VAYQËRËU-TSOM","portuguese":"e proclamaram (um) jejum,","number":"3.5"},{"hebrew":"וַיִּלְבְּשׁוּ","transliteration":"VAYLËBËSHU","portuguese":"e vestiram-se de","number":"3.5"},{"hebrew":"שַׂקִּים","transliteration":"SAQYM","portuguese":"saco, {lit.: sacos}","number":"3.5"},{"hebrew":"מִגְּדוֹלָם","transliteration":"MIGËDOLÅM","portuguese":"desde (o) maior {lit.: desde (o) maior deles}","number":"3.5"},{"hebrew":"וְעַד- קְטַנָּם:","transliteration":"VËAD-QËTANÅM:","portuguese":"até (ao) menor. {lit.: e até (ao) menor deles}","number":"3.5"}]},{"book_abbrev":"jn","chapter":3,"verse":6,"text_pt":"Porque esta palavra chegou ao rei de Nínive, e levantou-se do seu trono, e tirou de si os seus vestidos, e cobriu-se de saco, e assentou-se sobre a cinza.","words":[{"hebrew":"וַיִּגַּע","transliteration":"VAYGA","portuguese":"Porque chegou","number":"3.6"},{"hebrew":"הַדָּבָר","transliteration":"HADÅVÅR","portuguese":"{o caso}","number":"3.6"},{"hebrew":"אֶל- מֶלֶךְ","transliteration":"EL-MELEKH","portuguese":"ao rei de","number":"3.6"},{"hebrew":"נִינְוֵה","transliteration":"NYNËVEH","portuguese":"Nínive,","number":"3.6"},{"hebrew":"וַיָּקָם","transliteration":"VAYÅQÅM","portuguese":"e levantou-se","number":"3.6"},{"hebrew":"מִכִּסְאוֹ","transliteration":"MIKISËO","portuguese":"do seu trono,","number":"3.6"},{"hebrew":"וַיַּעֲבֵר","transliteration":"VAYAAVER","portuguese":"e tirou","number":"3.6"},{"hebrew":"אַדַּרְתּוֹ","transliteration":"ADARËTO","portuguese":"{sua capa gloriosa}","number":"3.6"},{"hebrew":"מֵעָלָיו","transliteration":"MEÅLÅYV","portuguese":"de si","number":"3.6"},{"hebrew":"וַיְכַס","transliteration":"VAYËKHAS","portuguese":"e cobriu-se","number":"3.6"},{"hebrew":"שַׂק","transliteration":"SAQ","portuguese":"de saco,","number":"3.6"},{"hebrew":"וַיֵּשֶׁב","transliteration":"VAYESHEV","portuguese":"e assentou-se","number":"3.6"},{"hebrew":"עַל- הָאֵפֶר:","transliteration":"AL-HÅEFER:","portuguese":"sobre a cinza.","number":"3.6"}]},{"book_abbrev":"jn","chapter":3,"verse":7,"text_pt":"E fez uma proclamação, que se divulgou em Nínive, por mandado do rei e dos seus grandes, dizendo: Nem homens, nem animais, nem bois, nem ovelhas provem cousa alguma, nem se lhes dê pasto, nem bebam água.","words":[{"hebrew":"וַיַּזְעֵק","transliteration":"VAYAZËEQ","portuguese":"{e proclamou}","number":"3.7"},{"hebrew":"וַיֹּאמֶר","transliteration":"VAYOMER","portuguese":"{e disse}","number":"3.7"},{"hebrew":"בְּנִינְוֵה","transliteration":"BËNYNËVEH","portuguese":"em Nínive,","number":"3.7"},{"hebrew":"מִטַּעַם","transliteration":"MITAAM","portuguese":"{em nome de}","number":"3.7"},{"hebrew":"הַמֶּלֶךְ","transliteration":"HAMELEKH","portuguese":"{o rei}","number":"3.7"},{"hebrew":"וּגְדֹלָיו","transliteration":"UGËDOLÅYV","portuguese":"e (dos) seus grandes,","number":"3.7"},{"hebrew":"לֵאמֹר","transliteration":"LEMOR","portuguese":"dizendo: {lit.: dizer}","number":"3.7"},{"hebrew":"הָאָדָם","transliteration":"HÅÅDÅM","portuguese":"{o homem}","number":"3.7"},{"hebrew":"וְהַבְּהֵמָה","transliteration":"VËHABËHEMÅH","portuguese":"{e o animal}","number":"3.7"},{"hebrew":"הַבָּקָר","transliteration":"HABÅQÅR","portuguese":"{o gado graúdo}","number":"3.7"},{"hebrew":"וְהַצֹּאן","transliteration":"VËHATSON","portuguese":"{e o gado miúdo}","number":"3.7"},{"hebrew":"אַל- יִטְעֲמוּ","transliteration":"AL-YTËAMU","portuguese":"{não provarão}","number":"3.7"},{"hebrew":"מְאוּמָה","transliteration":"MËUMÅH","portuguese":"cousa alguma,","number":"3.7"},{"hebrew":"אַל- יִרְעוּ","transliteration":"AL-YRËU","portuguese":"{não pastarão}","number":"3.7"},{"hebrew":"וּמַיִם","transliteration":"UMAYM","portuguese":"{e água}","number":"3.7"},{"hebrew":"אַל- יִשְׁתּוּ:","transliteration":"AL-YSHËTÅ:","portuguese":"{não beberão}","number":"3.7"}]},{"book_abbrev":"jn","chapter":3,"verse":8,"text_pt":"Mas os homens e os animais estarão cobertos de sacos, e clamarão fortemente a Deus, e se converterão, cada um do seu mau caminho, e da violência que há nas suas mãos.","words":[{"hebrew":"וְיִתְכַּסּוּ","transliteration":"VËYTËKASU","portuguese":"{e se cobrirão (de)}","number":"3.8"},{"hebrew":"שַׂקִּים","transliteration":"SAQYM","portuguese":"sacos,","number":"3.8"},{"hebrew":"הָאָדָם","transliteration":"HÅÅDÅM","portuguese":"{o homem}","number":"3.8"},{"hebrew":"וְהַבְּהֵמָה","transliteration":"VËHABËHEMÅH","portuguese":"{e o animal}","number":"3.8"},{"hebrew":"וְיִקְרְאוּ","transliteration":"VËYQËRËU","portuguese":"e clamarão","number":"3.8"},{"hebrew":"אֶל- אֱלֹהִים","transliteration":"EL-ELOHYM","portuguese":"a Deus,","number":"3.8"},{"hebrew":"בְּחָזְקָה","transliteration":"BËCHÅZËQÅH","portuguese":"fortemente","number":"3.8"},{"hebrew":"וְיָשֻׁבוּ","transliteration":"VËYÅSHUVU","portuguese":"e se converterão,","number":"3.8"},{"hebrew":"אִישׁ","transliteration":"YSH","portuguese":"cada um","number":"3.8"},{"hebrew":"מִדַּרְכּוֹ","transliteration":"MIDARËKO","portuguese":"do seu caminho,","number":"3.8"},{"hebrew":"הָרָעָה","transliteration":"HÅRÅÅH","portuguese":"mau","number":"3.8"},{"hebrew":"וּמִן- הֶחָמָס","transliteration":"UMIN-HECHÅMÅS","portuguese":"e da violência","number":"3.8"},{"hebrew":"אֲשֶׁר","transliteration":"ASHER","portuguese":"que (há)","number":"3.8"},{"hebrew":"בְּכַפֵּיהֶם:","transliteration":"BËKHAPEYHEM:","portuguese":"nas suas mãos.","number":"3.8"}]},{"book_abbrev":"jn","chapter":3,"